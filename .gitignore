# ============================================================
# 环境隔离：本仓库只跟踪「项目内」文件。
# 所有可再生成的中间产物、缓存、构建输出一律忽略，
# 禁止将全局环境路径（~/.gradle、~/.cache 等）纳入版本控制。
# ============================================================

# ---- Python（项目内 venv 与缓存）----
.venv/
__pycache__/
*.py[cod]

# ---- Gradle 缓存与构建产物（缓存已指向项目内 .gradle/）----
.gradle/
**/build/
**/.cxx/
.kotlin/
local.properties

# ---- 中间产物（可重新生成）----
apk/decoded/
apk/decompiled/
static-data/raw/

# ---- 二进制输入（大文件，不入库，仅保留本机）----
apk/*.apk

# ---- 大工具（本机安装，不入库：NDK 2GB / lspatch 等）----
tools/

# ---- 构建产物 APK（可重新构建）----
output/*.apk

# ---- 打包进 APK 的静态数据（package_assets.py 生成，可重新生成）----
module/app/src/main/assets/static-data/

# ---- 测试日志 / 采样数据 ----
log/

# ---- 临时文件 ----
.tmp/

# ---- 探索研究归档（中间产物，不入库）----
archive/

# ---- 编辑器/系统杂项 ----
.DS_Store
*.swp

# ---- 其他文件 ----
.sisyphus
