[Unit]
Description=Waydroid session (headless)
After=waydroid-container.service weston-headless.service
Requires=waydroid-container.service weston-headless.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/0 /run/user/0/pulse; touch /run/user/0/pulse/native; if ! pgrep -f "dbus-daemon --session --address=unix:path=/run/user/0/dbus-session" >/dev/null 2>&1; then dbus-daemon --session --address=unix:path=/run/user/0/dbus-session --fork; fi'
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/dbus-session
Environment=WAYLAND_DISPLAY=waydroid
Environment=XDG_RUNTIME_DIR=/run/user/0
ExecStart=/usr/bin/waydroid session start
